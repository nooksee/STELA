#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/ops/lib/scripts/common.sh"

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  die "git repo not found. Run from repo root."
fi

if [[ "$(pwd -P)" != "$REPO_ROOT" ]]; then
  die "Run from repo root: $REPO_ROOT"
fi

project_name="${1:-}"
if [[ -z "$project_name" ]]; then
  die "project name is required"
fi
if [[ $# -ne 1 ]]; then
  die "usage: ops/bin/scaffold <project-name>"
fi
if [[ ! "$project_name" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  die "invalid project name: $project_name"
fi

project_dir="$REPO_ROOT/projects/$project_name"
if [[ -e "$project_dir" ]]; then
  die "project already exists: projects/$project_name"
fi

scaffold_spec="$REPO_ROOT/ops/lib/project/SCAFFOLD.md"
if [[ ! -f "$scaffold_spec" ]]; then
  die "missing scaffold spec: ops/lib/project/SCAFFOLD.md"
fi
contract_template="$REPO_ROOT/ops/lib/project/STELA.md"
if [[ ! -f "$contract_template" ]]; then
  die "missing project contract template: ops/lib/project/STELA.md"
fi
project_registry="$REPO_ROOT/docs/ops/registry/projects.md"
if [[ ! -f "$project_registry" ]]; then
  die "missing project registry: docs/ops/registry/projects.md"
fi
if grep -Eq "^\|[[:space:]]*${project_name}[[:space:]]*\|" "$project_registry"; then
  die "project already registered: ${project_name} (docs/ops/registry/projects.md)"
fi
if ! grep -Eq '^Current:[[:space:]]' "$project_registry"; then
  die "project registry has no Current line: docs/ops/registry/projects.md"
fi

trap 'emit_binary_leaf "scaffold" "finish"' EXIT
emit_binary_leaf "scaffold" "start"

created_at="$(date -u +%Y-%m-%d)"

# Resolve the three scaffold tokens in a copied source file (DP-OPS-0273):
# PROJECT_ID and CREATED_AT are facts the binary knows; DISPLAY_NAME starts
# as the project id and the owner may change it.
render_project_file() {
  local source_path="$1"
  local target_path="$2"
  sed \
    -e "s/{{PROJECT_ID}}/${project_name}/g" \
    -e "s/{{DISPLAY_NAME}}/${project_name}/g" \
    -e "s/{{CREATED_AT}}/${created_at}/g" \
    "$source_path" > "$target_path"
}

mkdir -p "$project_dir"

# Provision the standard optional directories listed in the scaffold spec.
while IFS= read -r line; do
  if [[ "$line" =~ ^-[[:space:]]+([a-zA-Z0-9._-]+)/$ ]]; then
    mkdir -p "$project_dir/${BASH_REMATCH[1]}"
  fi
done < "$scaffold_spec"

# Job 1: the scaffold spec copy. Job 2: the project contract copy. Job 3: the
# registry row (DP-OPS-0273). Allowlist rows and packet drafting stay manual,
# and docs/MAP.md is regenerated by ./ops/bin/map after this binary returns.
render_project_file "$scaffold_spec" "$project_dir/SCAFFOLD.md"
render_project_file "$contract_template" "$project_dir/STELA.md"

registry_tmp="$(mktemp)"
awk -v name="$project_name" '
  /^Current:[[:space:]]/ {
    line=$0
    sub(/^Current:[[:space:]]*/, "", line)
    if (line == "none" || line == "") {
      print "Current: " name
    } else {
      print "Current: " line ", " name
    }
    next
  }
  { print }
' "$project_registry" > "$registry_tmp"
printf '| %s | %s | projects/%s | active | Scaffolded %s; `STELA.md` advisory until the first project contract is ratified. |\n' \
  "$project_name" "$project_name" "$project_name" "$created_at" >> "$registry_tmp"
mv "$registry_tmp" "$project_registry"

echo "projects/$project_name"
echo "projects/$project_name/STELA.md"
echo "docs/ops/registry/projects.md: row added; run ./ops/bin/map"

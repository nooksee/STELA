#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ops/bin/allowlist

Runs the authoritative integrity scope check as a pre-certification dry run.
USAGE
}

if [[ "$#" -gt 1 ]]; then
  usage >&2
  exit 1
fi

if [[ "$#" -eq 1 ]]; then
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
fi

if ! command -v git >/dev/null 2>&1 || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ERROR: Must be run inside a git repository." >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# shellcheck source=/dev/null
source "${REPO_ROOT}/ops/lib/scripts/common.sh"

trap 'emit_binary_leaf "allowlist" "finish"' EXIT
emit_binary_leaf "allowlist" "start"

integrity_output=""
if ! integrity_output="$(bash "${REPO_ROOT}/tools/lint/integrity.sh" 2>&1)"; then
  printf '%s\n' "$integrity_output" >&2
  echo "FAIL: pre-certification scope dry run" >&2
  exit 1
fi

printf '%s\n' "$integrity_output"
echo "OK: pre-certification scope dry run passed"
